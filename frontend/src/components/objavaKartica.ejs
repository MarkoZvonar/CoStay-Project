<div class="kartica">
  <!-- 1. dio: Slika, datum, lokacija i cijena -->
  <div class="karticaSlika">
    <% const slike = (smjestaj.OBJAVA_SLIKA || []).filter(slika => slika.url_slika); %>

    <div class="galerija">
      <% if (slike.length > 0) { %>
        <% slike.forEach((slika, index) => { %>
          <img
            src="<%= slika.url_slika %>"
            alt="Slika smještaja"
            class="galerijaSlika <%= index === 0 ? 'aktivna' : '' %>"
          />
        <% }) %>
      <% } else { %>
        <img
          src="<%= smjestaj.slika_url || '/assets/probnaSlikaKartica.jpg' %>"
          alt="Slika smještaja"
          class="galerijaSlika aktivna"
        />
      <% } %>

      <% if (slike.length > 1) { %>
        <button type="button" class="galerijaStrelica lijevo" aria-label="Prethodna slika">&#10094;</button>
        <button type="button" class="galerijaStrelica desno" aria-label="Sljedeća slika">&#10095;</button>
        <span class="galerijaBrojac">1 / <%= slike.length %></span>
      <% } %>
    </div>

    <% const spremljeno = spremljeneObjaveIds && spremljeneObjaveIds.includes(smjestaj.id_objava); %>

    <% if (!jeGost) { %>
      <button
        type="button"
        class="spremiGumb <%= spremljeno ? 'spremljen' : '' %>"
        data-id="<%= smjestaj.id_objava %>"
        data-spremljeno="<%= spremljeno %>"
        aria-label="<%= spremljeno ? 'Ukloni iz spremljenih' : 'Spremi objavu' %>"
      >
        <%= spremljeno ? '♥' : '+' %>
      </button>
    <% } %>

    <div class="datum">
      <%
        const options = { month: 'short', day: 'numeric' };
        const checkInDate = smjestaj.check_in
          ? new Date(smjestaj.check_in).toLocaleDateString('en-US', options)
          : 'Jan 12';
        const checkOutDate = smjestaj.check_out
          ? new Date(smjestaj.check_out).toLocaleDateString('en-US', options)
          : 'Mar 4';
      %>

      <%= checkInDate %> - <%= checkOutDate %>
    </div>

    <div class="slikaDno">
      <div class="lokacija">
        <span class="lokacijaIkona">📍</span>
        <span>
          <%= smjestaj.id_lokacije
            ? smjestaj.id_lokacije.ime_lokacije + ', ' + smjestaj.id_lokacije.ime_drzave
            : 'Nepoznata lokacija' %>
        </span>
      </div>

      <div class="cijena">
        <%= smjestaj.ukupna_cijena %> €
      </div>
    </div>
  </div>

  <!-- 2. dio: Tagovi -->
  <div class="karticaTagovi">
    <% if (smjestaj.OBJAVA_TAG && smjestaj.OBJAVA_TAG.length > 0) { %>
      <% smjestaj.OBJAVA_TAG.forEach(t => { %>
        <%
          const nazivTaga = t.TAG
            ? t.TAG.ime_tag
            : (t.id_tag ? t.id_tag.ime_tag : t.ime_tag);
        %>

        <% if (nazivTaga) { %>
          <span class="tag"><%= nazivTaga.trim() %></span>
        <% } %>
      <% }) %>
    <% } else { %>
      <span class="tag">Smještaj</span>
    <% } %>
  </div>

  <!-- 3. dio: Kapacitet -->
  <div class="karticaKapacitet">
    <div class="kapacitetStavka">
      <span class="kapacitetNaslov">Ukupni kapacitet</span>
      <span class="kapacitetVrijednost">
        <%= smjestaj.ukupni_kapacitet %> osoba
      </span>
    </div>

    <div class="kapacitetStavka">
      <span class="kapacitetNaslov">Preostala mjesta</span>
      <span class="kapacitetVrijednost">
        <%= smjestaj.preostalih_mjesta %> osoba
      </span>
    </div>
  </div>

  <!-- 4. dio: Kontakt -->
  <div class="karticaKontakt">
    <div class="organizator">
      <span class="organizatorNaslov">Organizator</span>
      <span class="organizatorIme">
        <%= smjestaj.id_autor
          ? (smjestaj.id_autor.ime + ' ' + smjestaj.id_autor.prezime)
          : 'Ivan Horvat' %>
      </span>
    </div>

    <%
      const mojZahtjev = (mojiZahtjevi || []).find(
        z => String(z.id_objava) === String(smjestaj.id_objava)
      );

      const prihvacen = mojZahtjev?.status_zahtjeva === "prihvacen";
      const poslan = mojZahtjev?.status_zahtjeva === "na_cekanju";
    %>

    <button
      type="button"
      class="messageGumb"
      id="zahtjev-<%= smjestaj.id_objava %>"
      onclick="posaljiZahtjev('<%= smjestaj.id_objava %>')"
      <%= (prihvacen || poslan) ? "disabled" : "" %>
    >
      <%= prihvacen ? "ZAHTJEV PRIHVAĆEN" : poslan ? "ZAHTJEV POSLAN" : "POŠALJI ZAHTJEV" %>
    </button>
  </div>
</div>
