<% if (objave.length === 0) { %>
  <p class="postoviPoruka"><%= praznaPoruka %></p>
<% } else { %>
  <% objave.forEach((smjestaj) => { %>
    <%
      const slikaUrl =
        smjestaj.OBJAVA_SLIKA?.[0]?.url_slika ||
        "/assets/probnaSlikaKartica.jpg";

      const options = {
        month: "short",
        day: "numeric",
        timeZone: "UTC"
      };

      const checkInDate = smjestaj.check_in
        ? new Date(smjestaj.check_in).toLocaleDateString("en-US", options)
        : "";

      const checkOutDate = smjestaj.check_out
        ? new Date(smjestaj.check_out).toLocaleDateString("en-US", options)
        : "";

      const datum = [checkInDate, checkOutDate]
        .filter(Boolean)
        .join(" - ");
    %>

    <div class="kartica">
      <div class="karticaSlika">
        <img src="<%= slikaUrl %>" alt="Slika smještaja" />

        <% if (spremljene) { %>
          <button
            type="button"
            class="spremiGumb spremljen"
            data-id="<%= smjestaj.id_objava %>"
            aria-label="Ukloni iz spremljenih"
          >
            ♥
          </button>
        <% } %>

        <% if (datum) { %>
          <div class="datum"><%= datum %></div>
        <% } %>

        <div class="slikaDno">
          <div class="lokacija">
            <span class="lokacijaIkona">📍</span>
            <span>
              <%= smjestaj.id_lokacije
                ? [
                    smjestaj.id_lokacije.ime_lokacije,
                    smjestaj.id_lokacije.ime_drzave
                  ].filter(Boolean).join(", ")
                : "Nepoznata lokacija"
              %>
            </span>
          </div>

          <div class="cijena">
            <%= smjestaj.ukupna_cijena %> €
          </div>
        </div>
      </div>

      <div class="karticaTagovi">
        <% if (smjestaj.OBJAVA_TAG?.length > 0) { %>
          <% smjestaj.OBJAVA_TAG.forEach((zapis) => { %>
            <% if (zapis.TAG?.ime_tag) { %>
              <span><%= zapis.TAG.ime_tag.trim() %></span>
            <% } %>
          <% }); %>
        <% } else { %>
          <span>Smještaj</span>
        <% } %>
      </div>

      <div class="karticaKapacitet">
        <div class="kapacitetStavka">
          <span class="kapacitetNaslov">Ukupni kapacitet</span>
          <span class="kapacitetVrijednost">
            <%= smjestaj.ukupni_kapacitet %> osoba
          </span>
        </div>

        <div class="kapacitetStavka">
          <span class="kapacitetNaslov">Preostala mjesta</span>
          <span class="kapacitetVrijednost">
            <%= smjestaj.preostalih_mjesta %> osoba
          </span>
        </div>
      </div>

      <div class="karticaKontakt">
        <div class="organizator">
          <span class="organizatorNaslov">Organizator</span>
          <span class="organizatorIme">
            <%= smjestaj.id_autor
              ? smjestaj.id_autor.ime + " " + smjestaj.id_autor.prezime
              : "Nepoznat organizator"
            %>
          </span>
        </div>

        <% if (!spremljene) { %>
          <a href="/edit/<%= smjestaj.id_objava %>" class="messageGumb">Edit</a>
        <% } else { %>
          <a href="#" class="messageGumb">Message</a>
        <% } %>
      </div>
    </div>
  <% }); %>
<% } %>