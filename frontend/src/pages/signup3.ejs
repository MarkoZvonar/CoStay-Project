<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CoStay — dovršavanje profila</title>

    <link rel="stylesheet" href="/pages/signup3.css" />
  </head>

  <body>
    <div id="reg-box">
      <h2 class="naslov">Napravi CoStay račun</h2>
      <h1 class="opis">Zadnji korak...</h1>

      <div id="progress">
        <a id="prog1">████</a>
        <a id="prog2">████</a>
        <a id="prog3">████</a>
      </div>

      <form id="form" action="/signup3" method="POST">
        <label for="opis">Opis — neobavezno:</label>
        <textarea
          id="opis"
          name="opis"
          rows="5"
          cols="40"
          maxlength="2000"
          placeholder="Unesi opis..."
        ><%= opis %></textarea>
        
        <fieldset id="tagovi">
          <legend>Ključne riječi — neobavezno</legend>

          <% if (dostupniTagovi.length === 0) { %>
            <p>Trenutačno nema dostupnih ključnih riječi.</p>
          <% } %>

          <% dostupniTagovi.forEach((tag) => { %>
            <label>
              <input
                type="checkbox"
                name="tagovi"
                value="<%= tag.id_tag %>"
                <%= odabraniTagovi.includes(tag.id_tag) ? "checked" : "" %>
              />
              <%= tag.ime_tag %>
            </label>
          <% }); %>
          <p>Postojeće ključne riječi ostaju spremljene. Ukloniti ih možeš na profilu.</p>
        </fieldset>

        <button type="submit">Spremi i nastavi</button>
      </form>

      <p>
        <a href="/discover">Preskoči i nastavi na Discover</a>
      </p>

      <div id="login-container">
        <div class="link">
          <p><a href="/signup2">Vrati se</a></p>
        </div>
      </div>
    </div>
  </body>
</html>