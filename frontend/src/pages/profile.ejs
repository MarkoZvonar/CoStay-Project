<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/pages/profile.css" />
    <link rel="stylesheet" href="/pages/main.css" />
    <link rel="stylesheet" href="/pages/posts-profile.css" />
    <script src="/pages/profile.js" defer></script>
    <title>Profile</title>
  </head>

  <body>
    <div class="profilGornjiDio">
      <div class="profile">
        <div class="profilnaSlika">
          <img
            src="<%= profilnaSlikaUrl || '/assets/probnaSlikaKartica.jpg' %>"
            alt="Profilna slika"
          />
        </div>

        <div class="profilIme"><%= ime %> <%= prezime %></div>

        <div class="profilLokacija"><%= mjestoStanovanja %></div>
        <a href="/profile/reviews" class="profilRecenzije">
          <span class="recenzijeNaslov">Recenzije</span>
      
          <span class="recenzijeOcjena">
              <span class="zvjezdica">★</span>
              <%= prosjecnaOcjena %> / 5
          </span>
      
          <span class="recenzijeBroj">
              (<%= brojRecenzija %>)
          </span>
        </a>
        <div class="profilOpis">
          <%= opis %>
        </div>
        <form action="/logout" method="POST">
          <button type="submit" class="addGumb">Log out</button>
        </form>

        <a href="/profile/edit" class="editGumb">Edit profile</a>
      </div>

      <div class="tagovi">
        <div class="tagoviNaslov">Travel Keywords</div>

        <div class="tagoviUnos">
          <div class="tagoviInput">
            <img class="tagoviIkona" src="/assets/tags.svg" alt="" />
            <input id="unosTaga" type="text" list="ponudeniTagovi" placeholder="Add a travel keyword..." autocomplete="off"/>
            <datalist id="ponudeniTagovi">
              <!-- tu js dodaje ponudene tagove iz baze -->
            </datalist>
          </div>

          <button id="dodajTag" class="addGumb">Add</button>
        </div>

        <p id="tagoviPoruka" hidden></p>

        <div id="listaTagova" class="listaTagova">
          <% tagovi.forEach((tag) => {%>
            <span class="tag">
              <%= tag.ime_tag %>
              <button id="<%= tag.id_tag %>" class="ukloniTag" type="button" aria-label="Ukloni <%= tag.ime_tag %>">
              ×
              </button>
            </span>
          <% }); %>
        </div>
      </div>
    </div>

    <div class="postoviSekcija">
      <div class="postoviTabs">
        <div id="tabMojeObjave" class="postoviTabAktivan">
          <h2 class="postoviNaslov">My Posts</h2>
        </div>
        <div id="tabZahtjeviObjave" class="postoviTab">
          <h2 class="postoviNaslov">My requests</h2>
        </div>
        <div id="tabSpremljeneObjave" class="postoviTab">
          <h2 class="postoviNaslov">Saved Posts</h2>
        </div>
      </div>

      <div id="mojeObjave" class="postovi">
        <%- include('../components/profileposts', {
          objave: mojeObjave,
          spremljene: false,
          praznaPoruka: "You haven't posted anything yet."
        }) %>
      </div>
      <div id="mojiZahtjevi" class="postovi" hidden>
        <%- include('../components/profileposts', {
          objave: mojiZahtjevi,
          spremljene: true,
          praznaPoruka: "You haven't made any requests yet."
        }) %>
      </div>
      <div id="spremljeneObjave" class="postovi" hidden>
        <%- include('../components/profileposts', {
          objave: spremljeneObjave,
          spremljene: true,
          praznaPoruka: "You haven't saved any posts yet."
        }) %>
      </div>
    </div>
    
    <div id="navbar"></div>
    <%- include('../components/navbar') %>
  </body>
</html>
