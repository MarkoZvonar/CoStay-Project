<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/pages/profile.css" />
    <link rel="stylesheet" href="/pages/main.css" />
    <title>Profile</title>
  </head>

  <body>
    <div class="profilGornjiDio">
      <div class="profile">
        <div class="profilnaSlika">
          <img src="/assets/probnaSlikaKartica.jpg" alt="Profilna slika" />
        </div>

        <div class="profilIme"><%= ime %> <%= prezime %></div>

        <div class="profilLokacija">Zagreb, Hrvatska</div>

        <div class="profilOpis">
          Student sam koji voli putovati, upoznavati nove ljude i otkrivati
          zanimljiva mjesta. Uvijek sam za nova iskustva i dobra druženja!
        </div>
      </div>

      <div class="tagovi">
        <div class="tagoviNaslov">Travel Keywords</div>

        <div class="tagoviUnos">
          <div class="tagoviInput">
            <img class="tagoviIkona" src="/assets/tags.svg" alt="" />
            <input type="text" placeholder="Add a travel keyword..." />
          </div>

          <button class="addGumb">Add</button>
        </div>

        <div class="listaTagova">
          <span class="tag">
            Adventure
            <button
              class="ukloniTag"
              type="button"
              aria-label="Ukloni Adventure"
            >
              ×
            </button>
          </span>

          <span class="tag">
            Nature
            <button class="ukloniTag" type="button" aria-label="Ukloni Nature">
              ×
            </button>
          </span>

          <span class="tag">
            Beach
            <button class="ukloniTag" type="button" aria-label="Ukloni Beach">
              ×
            </button>
          </span>

          <span class="tag">
            City Break
            <button
              class="ukloniTag"
              type="button"
              aria-label="Ukloni City Break"
            >
              ×
            </button>
          </span>
        </div>
      </div>
    </div>

