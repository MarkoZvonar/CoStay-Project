<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/pages/create.css" />
    <link rel="stylesheet" href="/pages/main.css" />
    <title>Create Post</title>
  </head>

  <body>
    <main class="createTijelo">
      <h1 class="createNaslov">Create Travel Post</h1>

      <form
        action="/api/posts"
        method="POST"
        class="createForma"
        id="createForm"
      >
        <!-- Lokacija -->
        <div class="formGroup">
          <label for="lokacija" class="obavezno">Location</label>
          <input
            type="text"
            id="lokacija"
            name="lokacija"
            placeholder="e.g. Split, Croatia"
            required
          />
        </div>

        <!-- Datumi (Dolazak i Odlazak) -->
        <div class="formRow">
          <div class="formGroup">
            <label for="datumDolaska" class="obavezno">Arrival Date</label>
            <input type="date" id="datumDolaska" name="datumDolaska" required />
          </div>
          <div class="formGroup">
            <label for="datumOdlaska" class="obavezno">Departure Date</label>
            <input type="date" id="datumOdlaska" name="datumOdlaska" required />
          </div>
        </div>

        <!-- Cijena i Broj osoba -->
        <div class="formRow">
          <div class="formGroup">
            <label for="ukupnaCijena" class="obavezno">Total Price (€)</label>
            <input
              type="number"
              id="ukupnaCijena"
              name="ukupnaCijena"
              placeholder="e.g. 500"
              required
            />
          </div>
          <div class="formGroup">
            <label for="brojOsoba" class="obavezno"
              >Total People (incl. you)</label
            >
            <input
              type="number"
              id="brojOsoba"
              name="brojOsoba"
              min="2"
              placeholder="e.g. 4"
              required
            />
          </div>
        </div>

        <!-- Krajnji rok za prikupljanje -->
        <div class="formGroup">
          <label for="krajnjiRok" class="obavezno">Deadline for Buddies</label>
          <input type="date" id="krajnjiRok" name="krajnjiRok" required />
        </div>

        <!-- Slike i Vanjski oglas -->
        <div class="formGroup">
          <label for="slikeSmjestaja">Accommodation Images (URL)</label>
          <input
            type="text"
            id="slikeSmjestaja"
            name="slikeSmjestaja"
            placeholder="Paste image link..."
          />
        </div>

        <div class="formGroup">
          <label for="vanjskiOglas">External Link (e.g. Booking)</label>
          <input
            type="url"
            id="vanjskiOglas"
            name="vanjskiOglas"
            placeholder="https://..."
          />
        </div>

        <!-- Tagovi / Atmosfera -->
        <div class="formGroup">
          <label for="tagovi">Vibe Tags (comma separated)</label>
          <input
            type="text"
            id="tagovi"
            name="tagovi"
            placeholder="e.g. beach, party, chill"
          />
        </div>

        <!-- Opis -->
        <div class="formGroup">
          <label for="opis" class="obavezno">Description</label>
          <textarea
            id="opis"
            name="opis"
            rows="4"
            placeholder="Describe your travel plan..."
            required
          ></textarea>
        </div>

        <button type="submit" class="submitGumb">Publish Post</button>
      </form>
    </main>

    <div id="navbar"></div>

    <%- include('../components/navbar') %>

    <script src="create.js"></script>
  </body>
</html>
