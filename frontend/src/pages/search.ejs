<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/pages/search.css" />
    <link rel="stylesheet" href="/pages/main.css" />
    <script src="/components/map.js"></script>
    <title>Search</title>
  </head>

  <body>
    <div class="naslov">
      <a class="logo">Pretraga objava</a>
      <div class="ikone">
        <a href="discover.html" class="obavijestiGumb"
          ><img src="/assets/notification.svg" alt=""
        /></a>
        <a href="discover.html" class="izbornikGumb"
          ><img src="/assets/menu.svg" alt=""
        /></a>
      </div>
    </div>

    <% if (query == 0) { %>
      <form id="form" action="/search" method="POST">
        <div class="formGrupa">
          <div class="location-group">
            <% if (map == 0) { %>
              <input type="hidden" name="mapq" id="mapq" value="0">
              <div class="location-text">
                <label for="location">Location:</label>
                <input type="text" id="location" name="location" />
              </div>

              <a href="/search/map" class="map-button">
                <span>Show Map</span>
              </a>
            <% } else { %>
              <div class="location-text">
                <label for="radius">Location Radius (km):</label>
                <input type="number" id="radius" name="radius" min="0" step="0.1" max="100" placeholder="Default: 10"/>
              </div>

              <a href="/search" class="map-button">
                <span>Hide Map</span>
              </a>
            <% } %>
          </div>

          <% if (map == 1) { %>
            <input type="hidden" name="latitude" id="latitude">
            <input type="hidden" name="longitude" id="longitude">
            <input type="hidden" name="mapq" id="mapq" value="1">

            <div id="autocomplete-container"></div>

            <div id="map"></div>

            <script
              async
              src="https://maps.googleapis.com/maps/api/js?key=AIzaSyArVnQ6kpduKhsjXhQT2_exD7nY-GWilIY&loading=async&libraries=places&callback=initMap">
            </script>
          <% } %>
        </div>

        <div id="date">
          <div id="in" class="formGrupa">
            <label for="checkin">Date of Arrival:</label>
            <input type="date" id="checkin" name="checkin" />

            <div class="radio">
              <label class="radio-option">
                  <input type="radio" name="rcheckin" value="before">
                  Before
              </label>
              <label class="radio-option">
                  <input type="radio" name="rcheckin" value="exact" checked>
                  Exact
              </label>
              <label class="radio-option">
                  <input type="radio" name="rcheckin" value="after">
                  After
              </label>
            </div>
          </div>

          <div id="out" class="formGrupa">
            <label for="checkout">Date of Departure:</label>
            <input type="date" id="checkout" name="checkout" />

            <div class="radio">
              <label class="radio-option">
                  <input type="radio" name="rcheckout" value="before">
                  Before
              </label>
              <label class="radio-option">
                  <input type="radio" name="rcheckout" value="exact" checked>
                  Exact
              </label>
              <label class="radio-option">
                  <input type="radio" name="rcheckout" value="after">
                  After
              </label>
            </div>
          </div>
        </div>

        <div id="date">
          <div class="formGrupa">
            <label for="price">Max Price:</label>
            <input type="number" id="price" name="price" />

            <div class="radio">
              <label class="radio-option">
                  <input type="radio" name="rprice" value="min">
                  Min
              </label>
              <label class="radio-option">
                  <input type="radio" name="rprice" value="exact" checked>
                  Exact
              </label>
              <label class="radio-option">
                  <input type="radio" name="rprice" value="max">
                  Max
              </label>
            </div>
          </div>

          <div class="formGrupa">
            <label for="capacity">Capacity:</label>
            <input type="number" id="capacity" name="capacity" />

            <div class="radio">
              <label class="radio-option">
                  <input type="radio" name="rcapacity" value="min">
                  Min
              </label>
              <label class="radio-option">
                  <input type="radio" name="rcapacity" value="exact" checked>
                  Exact
              </label>
              <label class="radio-option">
                  <input type="radio" name="rcapacity" value="max">
                  Max
              </label>
            </div>
          </div>          
        </div>

        <div class="tagovi">
          <a>Tags:</a>
          <label>
            <input type="checkbox" name="tags" value="Pool" />
            Pool
          </label>

          <label>
            <input type="checkbox" name="tags" value="Nature" />
            Nature
          </label>

          <label>
            <input type="checkbox" name="tags" value="Sport" />
            Sport
          </label>

          <label>
            <input type="checkbox" name="tags" value="Adventure" />
            Adventure
          </label>

          <label>
            <input type="checkbox" name="tags" value="Quiet" />
            Quiet
          </label>

          <label>
            <input type="checkbox" name="tags" value="Beach" />
            Beach
          </label>

          <label>
            <input type="checkbox" name="tags" value="Party" />
            Party
          </label>

          <label>
            <input type="checkbox" name="tags" value="High budget" />
            High Budget
          </label>

          <label>
            <input type="checkbox" name="tags" value="Low budget" />
            Low Budget
          </label>

          <label>
            <input type="checkbox" name="tags" value="Pet friendly" />
            Pet Friendly
          </label>

          <label>
            <input type="checkbox" name="tags" value="No pets" />
            No Pets
          </label>

          <label>
            <input type="checkbox" name="tags" value="LGBTQ+" />
            LGBTQ+
          </label>

          <label>
            <input type="checkbox" name="tags" value="Smoking allowed" />
            Smoking Allowed
          </label>

          <label>
            <input type="checkbox" name="tags" value="No smoking" />
            No Smoking
          </label>

          <label>
            <input type="checkbox" name="tags" value="Women only" />
            Women Only
          </label>

          <label>
            <input type="checkbox" name="tags" value="Men only" />
            Men Only
          </label>
        </div>

        <div class="formGrupa">
          <label for="organizator">Organizator:</label>
          <input type="text" id="organizator" name="organizator" />
        </div>

        <button type="submit">Traži</button>
      </form>

    <% } else { %>
      <div class="brojac">
        <div class="brojacTekst">
          <span class="brojacNadnaslov">TVOJI REZULTATI PRETRAGE</span>
          <h1>Pronađi svoj sljedeći boravak.</h1>

          <div class="brojacDetalji">
            <div class="brojacLokacija">
              <img src="/assets/brojacSlika.png" alt="" />
              <span>Zagreb, Hrvatska</span>
            </div>

            <span class="brojacBroj"><%= data.length %> smještaja</span>
          </div>
        </div>
      </div>

      <div class="tijelo">
        <% data.forEach((item) => { %>
          <% if (item.keep) { %>
            <div class="kartica">
              <!-- 1. dio: Slika, datum, lokacija i cijena -->
              <div class="karticaSlika">
                <img src="/assets/probnaSlikaKartica.jpg" alt="Slika smještaja" />

                <div class="datum">
                  <% 
                    const options = { month: 'short', day: 'numeric' };
                    const checkInDate = item.check_in ? new Date(item.check_in).toLocaleDateString('en-US', options) : 'no date';
                    const checkOutDate = item.check_out ? new Date(item.check_out).toLocaleDateString('en-US', options) : 'no date';
                  %>
                  <%= checkInDate %>-<%= checkOutDate %>
                </div>

                <div class="slikaDno">
                  <div class="lokacija">
                    <span class="lokacijaIkona">📍</span>
                    <span><%= item.LOKACIJA
                      ? item.LOKACIJA.ime_lokacije + ', ' + item.LOKACIJA.ime_drzave
                      : 'Nepoznata lokacija' %>
                    </span>
                  </div>

                  <div class="cijena"><%= Number(item.ukupna_cijena / item.ukupni_kapacitet).toFixed(2) %> € <span>/ noć</span></div>
                </div>
              </div>

              <!-- 2. dio: Tagovi -->
              <div class="karticaTagovi">
                <% if (item.OBJAVA_TAG && item.OBJAVA_TAG.length > 0) { %>
                  <% item.OBJAVA_TAG.forEach(t => { %>
                    <% const nazivTaga = t.TAG ? t.TAG.ime_tag : (t.id_tag ? t.id_tag.ime_tag : t.ime_tag); %>
                    <% if (nazivTaga) { %>
                      <span class="tag"><%= nazivTaga.trim() %></span>
                    <% } %>
                  <% }) %>
                <% } %>
              </div>

              <div class="karticaKapacitet">
                <div class="kapacitetStavka">
                  <span class="kapacitetNaslov">Ukupni kapacitet</span>
                  <span class="kapacitetVrijednost">
                    <%= item.ukupni_kapacitet %> osoba
                  </span>
                </div>

                <div class="kapacitetStavka">
                  <span class="kapacitetNaslov">Preostala mjesta</span>
                  <span class="kapacitetVrijednost">
                    <%= item.preostalih_mjesta %> osoba
                  </span>
                </div>
              </div>

              <!-- 3. dio: Kontakt -->
              <div class="karticaKontakt">
                <div class="organizator">
                  <span class="organizatorNaslov">Organizator</span>
                  <span class="organizatorIme"><%= item.KORISNIK.ime %> <%= item.KORISNIK.prezime %></span>
                </div>

                <button class="messageGumb">Message</button>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } %>

    <div id="navbar"></div>

    <%- include('../components/navbar') %>
  </body>
</html>
