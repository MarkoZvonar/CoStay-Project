<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/pages/search.css" />
    <link rel="stylesheet" href="/pages/main.css" />
    <title>Search</title>
  </head>

  <body>
    <main id="tijelo">
      <div class="naslov">
        <a class="logo">Pretraga objava</a>
      </div>

      <form id="form" action="/" method="POST">
        <div class="formGrupa">
          <label for="Location">Location:</label>
          <input type="text" id="location" name="location" />
        </div>

        <div id="date" class="formGrupa">
          <div id="in">
            <label for="checkin">Datum dolaska:</label>
            <input type="date" id="checkin" name="checkin" />
          </div>

          <div id="out">
            <label for="checkout">Datum odlaska:</label>
            <input type="date" id="checkout" name="checkout" />
          </div>
        </div>

        <div class="tagovi">
          <a>Tagovi:</a>
          <label>
            <input type="checkbox" name="plaza" />
            Plaža
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Planina
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Nightlife
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Chill
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Sport
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Grad
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Staromodno
          </label>

          <label>
            <input type="checkbox" name="plaza" />
            Moderno
          </label>
        </div>

        <div class="formGrupa">
          <label for="organizator">Organizator:</label>
          <input type="text" id="organizator" name="organizator" />
        </div>

        <button type="submit">Traži</button>
      </form>
    </main>

    <div id="navbar"></div>

    <script src="../components/navbar.js"></script>
  </body>
</html>
