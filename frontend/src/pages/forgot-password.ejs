<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CoStay — oporavak lozinke</title>

    <link rel="stylesheet" href="/pages/login.css" />
  </head>

  <body>
    <div id="login-box">
      <h1 class="naslov">Zaboravljena lozinka?</h1>

      <p>Unesi email adresu svojeg CoStay računa.</p>

      <form id="form" action="/auth/forgot-password" method="POST">
        <label for="email">Email:</label>

        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          maxlength="320"
          required
        />

        <button type="submit">Pošalji poveznicu</button>
      </form>

      <div id="login-container">
        <div class="link">
          <p><a href="/login">Povratak na prijavu</a></p>
        </div>
      </div>
    </div>
  </body>
</html>
