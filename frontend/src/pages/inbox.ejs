<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/pages/main.css" />
    <link rel="stylesheet" href="/pages/inbox.css" />
    <title>Inbox | CoStay</title>
    <script src="/inbox/supabase.js" defer></script>
    <script src="/services/inbox.js" defer></script>
  </head>
  <body>
    <main
      class="inboxTijelo"
      data-supabase-url="<%= supabaseUrl %>"
      data-supabase-key="<%= supabaseKey %>"
    >
      <header class="inboxZaglavlje">
        <div>
          <h1>Inbox</h1>
          <p>Dogovori sljedeće putovanje.</p>
        </div>
        <button id="osvjezi" type="button" class="sekundarniGumb">
          Osvježi
        </button>
      </header>
      <p id="inboxVeza" class="chatNapomena" role="status" hidden>
        Osvježavanje uživo trenutačno nije dostupno. Poruke možeš učitati gumbom Osvježi.
      </p>
      <p id="inboxStatus" role="status" aria-live="polite"></p>
      <div class="inboxRaspored">
        <section class="razgovori" aria-labelledby="razgovoriNaslov">
          <h2 id="razgovoriNaslov">Razgovori</h2>
          <div id="razgovoriLista">
            <p class="prazno">Učitavanje razgovora…</p>
          </div>
        </section>
        <section class="chat" aria-labelledby="chatNaslov">
          <header class="chatZaglavlje">
            <h2 id="chatNaslov">Odaberi razgovor</h2>
            <p id="chatSudionici" class="chatNapomena" hidden></p>
            <p class="chatNapomena">Prikazuje se do 100 najnovijih poruka.</p>
          </header>
          <div
            id="porukeLista"
            class="porukeLista"
            role="log"
            aria-label="Poruke"
            aria-live="polite"
          >
            <p class="prazno">
              Ovdje će se prikazati poruke odabranog razgovora.
            </p>
          </div>
          <form id="porukaObrazac" class="porukaObrazac">
            <label for="sadrzaj">Tvoja poruka</label>
            <div class="unosRed">
              <textarea
                id="sadrzaj"
                name="sadrzaj"
                rows="2"
                maxlength="2000"
                required
                disabled
                placeholder="Napiši poruku…"
              ></textarea>
              <button id="posalji" type="submit" disabled>Pošalji</button>
            </div>
            <p id="slanjeStatus" role="status" aria-live="polite"></p>
          </form>
        </section>
      </div>
      <noscript>Za razmjenu poruka uključi JavaScript u pregledniku.</noscript>
    </main>
    <%- include('../components/navbar') %>
  </body>
</html>
