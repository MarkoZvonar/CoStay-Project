<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Lovro Krčmarić" />
    <meta name="application-name" content="Lab1 iz WEB-a" />
    <link rel="stylesheet" href="/pages/discover.css" />
    <link rel="stylesheet" href="/pages/main.css" />
    <title>Discover</title>
  </head>

  <body>
    <div class="naslov">
      <a class="logo" href="discover.html">CoStay</a>

      <div class="ikone">
        <a href="discover.html" class="obavijestiGumb" aria-label="Obavijesti">
          <img src="/assets/notification.svg" alt="" />
        </a>

        <a href="discover.html" class="izbornikGumb" aria-label="Izbornik">
          <img src="/assets/menu.svg" alt="" />
        </a>
      </div>
    </div>

    <div class="brojac">
      <div class="brojacTekst">
        <span class="brojacNadnaslov">TVOJI REZULTATI PRETRAGE</span>
        <h1>Pronađi svoj sljedeći boravak.</h1>

        <div class="brojacDetalji">
          <div class="brojacLokacija">
            <img src="/assets/brojacSlika.png" alt="" />
            <span>Zagreb, Hrvatska</span>
          </div>
            <span class="brojacBroj"><%= typeof brojac !== 'undefined' ? brojac : (typeof smjestaji !== 'undefined' ? smjestaji.length : 0) %> smještaja</span>
        </div>
      </div>
    </div>

    <div class="tijelo">
      <% if (smjestaji && smjestaji.length > 0) { %>
        <% smjestaji.forEach(smjestaj => { %>
          <div class="kartica">
            <!-- 1. dio: Slika, datum, lokacija i cijena -->
            <div class="karticaSlika">
              <img src="<%= smjestaj.slika_url || '/assets/probnaSlikaKartica.jpg' %>" alt="Slika smještaja" />

              <div class="datum">
                <% 
                  const options = { month: 'short', day: 'numeric' };
                  const checkInDate = smjestaj.check_in ? new Date(smjestaj.check_in).toLocaleDateString('en-US', options) : 'Jan 12';
                  const checkOutDate = smjestaj.check_out ? new Date(smjestaj.check_out).getDate() : '13';
                %>
                <%= checkInDate %>-<%= checkOutDate %>
              </div>

              <div class="slikaDno">
                <div class="lokacija">
                  <span class="lokacijaIkona">📍</span>
                  <span><%= smjestaj.id_lokacija ? (smjestaj.id_lokacija.grad + ', ' + smjestaj.id_lokacija.drzava) : 'Zagreb, Hrvatska' %></span>
                </div>

                <div class="cijena"><%= smjestaj.ukupna_cijena ? Math.round(smjestaj.ukupna_cijena / 2) : 120 %> € <span>/ noć</span></div>
              </div>
            </div>

            <!-- 2. dio: Tagovi -->
            <div class="karticaTagovi">
              <% if (smjestaj.OBJAVA_TAG && smjestaj.OBJAVA_TAG.length > 0) { %>
                <% smjestaj.OBJAVA_TAG.forEach(t => { %>
                  <% const nazivTaga = t.TAG ? t.TAG.ime_tag : (t.id_tag ? t.id_tag.ime_tag : t.ime_tag); %>
                  <% if (nazivTaga) { %>
                    <span class="tag"><%= nazivTaga.trim() %></span>
                  <% } %>
                <% }) %>
              <% } else { %>
                <span class="tag">Smještaj</span>
              <% } %>
            </div>

            <!-- 3. dio: Kontakt -->
            <div class="karticaKontakt">
              <div class="organizator">
                <span class="organizatorNaslov">Organizator</span>
                <span class="organizatorIme">
                  <%= smjestaj.id_autor ? (smjestaj.id_autor.ime + ' ' + smjestaj.id_autor.prezime) : 'Ivan Horvat' %>
                </span>
              </div>

              <a href="<%= smjestaj.booking_url && smjestaj.booking_url !== 'nista' ? smjestaj.booking_url : '#' %>" class="messageGumb">Message</a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="grid-column: 1 / -1; text-align: center; font-size: 1.2rem; color: #666;">Trenutno nema pronađenih smještaja koji odgovaraju vašim tagovima.</p>
      <% } %>
    </div>

    <%- include('../components/navbar') %>
  </body>
</html>