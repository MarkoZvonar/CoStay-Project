<!doctype html>
<html lang="hr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="author" content="Lovro Krčmarić" />
  <meta name="application-name" content="Lab1 iz WEB-a" />
  <link rel="stylesheet" href="/pages/discover.css" />
  <link rel="stylesheet" href="/pages/main.css" />
  <title>Discover</title>
</head>

<body>
  <div class="naslov">
    <a class="logo" href="/discover">CoStay</a>

    <div class="ikone">
      <a href="/inbox" class="obavijestiGumb" aria-label="Obavijesti">
        <img src="/assets/notification.svg" alt="" />
      </a>

      <a href="/discover" class="izbornikGumb" aria-label="Izbornik">
        <img src="/assets/menu.svg" alt="" />
      </a>
    </div>
  </div>

  <div class="brojac">
    <div class="brojacTekst">
      <span class="brojacNadnaslov">TVOJI REZULTATI PRETRAGE</span>
      <h1>Pronađi svoj sljedeći boravak.</h1>

      <div class="brojacDetalji">
        <div class="brojacLokacija">
          <img src="/assets/brojacSlika.png" alt="" />
          <span>Zagreb, Hrvatska</span>
        </div>
        <span class="brojacBroj">
          <%= typeof brojac !=='undefined' ? brojac : (typeof smjestaji !=='undefined' ? smjestaji.length : 0) %>
            smještaja
        </span>
      </div>
    </div>
  </div>

    
    <div class="tijelo">

      <!-- Prvo prikazujemo objave koje odgovaraju tagovima korisnika -->
      <div id="objaveSTagovima" style="display: contents;">
        <% if (smjestaji && smjestaji.length > 0) { %>
          <% smjestaji.forEach(smjestaj => { %>
            <%- include('../components/objavaKartica', {
              smjestaj: smjestaj,
              spremljeneObjaveIds: spremljeneObjaveIds,
              mojiZahtjevi: mojiZahtjevi,
              jeGost: jeGost
            }) %>
          <% }) %>
        <% } else { %>
          <p style="grid-column: 1 / -1; text-align: center; font-size: 1.2rem; color: #666;">
            Trenutno nema objava koje odgovaraju vašim tagovima.
          </p>
        <% } %>
      </div>

      <!-- Separator između personaliziranih i ostalih objava -->

      <% if (!jeGost) { %>
        <div class="separatorObjava">
          <span>Ostale objave</span>
        </div>

        <div id="ostaleObjave" style="display: contents;"></div>

        <div id="ucitavanjeOstalih" style="grid-column: 1 / -1; height: 20px;"></div>
      <% } %>


    </div>



  <%- include('../components/navbar') %>
    <script>
      
      const tijelo = document.querySelector(".tijelo");

      // Promjena slika u galeriji i spremanje objava
      tijelo.addEventListener("click", async (event) => {

        // 1. GALERIJA SLIKA
        const strelica = event.target.closest(".galerijaStrelica");

        if (strelica) {
          const galerija = strelica.closest(".galerija");
          const slike = galerija.querySelectorAll(".galerijaSlika");
          const brojac = galerija.querySelector(".galerijaBrojac");

          let trenutnaSlika = 0;

          slike.forEach((slika, index) => {
            if (slika.classList.contains("aktivna")) {
              trenutnaSlika = index;
            }
          });

          if (strelica.classList.contains("lijevo")) {
            trenutnaSlika--;

            if (trenutnaSlika < 0) {
              trenutnaSlika = slike.length - 1;
            }
          } else {
            trenutnaSlika++;

            if (trenutnaSlika >= slike.length) {
              trenutnaSlika = 0;
            }
          }

          slike.forEach(slika => slika.classList.remove("aktivna"));
          slike[trenutnaSlika].classList.add("aktivna");

          if (brojac) {
            brojac.textContent = `${trenutnaSlika + 1} / ${slike.length}`;
          }

          return;
        }

        // 2. SPREMANJE OBJAVE
        const gumb = event.target.closest(".spremiGumb");

        if (gumb) {
          const idObjava = gumb.dataset.id;
          const spremljeno = gumb.dataset.spremljeno === "true";

          const metoda = spremljeno ? "DELETE" : "POST";

          gumb.disabled = true;

          try {
            const odgovor = await fetch(`/discover/spremi/${idObjava}`, {
              method: metoda,
            });

            if (!odgovor.ok) {
              throw new Error("Spremanje objave nije uspjelo.");
            }

            if (spremljeno) {
              gumb.textContent = "+";
              gumb.dataset.spremljeno = "false";
              gumb.classList.remove("spremljen");
              gumb.setAttribute("aria-label", "Spremi objavu");
            } else {
              gumb.textContent = "♥";
              gumb.dataset.spremljeno = "true";
              gumb.classList.add("spremljen");
              gumb.setAttribute("aria-label", "Ukloni iz spremljenih");
            }

          } catch (error) {
            console.error(error);
            alert("Došlo je do greške. Pokušajte ponovno.");
          } finally {
            gumb.disabled = false;
          }
        }
      });


      // 3. SLANJE ZAHTJEVA ZA PRIDRUŽIVANJE
      async function posaljiZahtjev(idObjava) {
        const gumb = document.getElementById(`zahtjev-${idObjava}`);

        if (gumb.disabled) return;

        gumb.disabled = true;

        try {
          const odgovor = await fetch(`/discover/pridruzi-se/${idObjava}`, {
            method: "POST",
          });

          const tekst = await odgovor.text();

          let rezultat;

          try {
            rezultat = JSON.parse(tekst);
          } catch {
            throw new Error("Neispravan odgovor servera.");
          }

          if (!odgovor.ok) {
            alert(rezultat.poruka || "Slanje zahtjeva nije uspjelo.");
            return;
          }

          gumb.textContent = "ZAHTJEV POSLAN";

          alert("Zahtjev za pridruživanje uspješno je poslan!");

        } catch (error) {
          console.error("Greška:", error);
          alert("Došlo je do greške. Pokušajte ponovno.");
        } finally {
          if (gumb.textContent !== "ZAHTJEV POSLAN") {
            gumb.disabled = false;
          }
        }
      }

            
      // 4. INFINITE SCROLL ZA OSTALE OBJAVE

      const jeGost = <%- JSON.stringify(jeGost) %>;

      if (!jeGost) {
        const spremnikOstalihObjava = document.getElementById("ostaleObjave");
        const ucitavanjeOstalih = document.getElementById("ucitavanjeOstalih");

        let offset = 0;
        let ucitavanjeUTijeku = false;
        let imaJosObjava = true;

        async function ucitajOstaleObjave() {
          // Sprječavamo istovremeno slanje više zahtjeva
          if (ucitavanjeUTijeku || !imaJosObjava) {
            return;
          }

          ucitavanjeUTijeku = true;

          try {
            const odgovor = await fetch(
              `/discover/ostale-objave?offset=${offset}`
            );

            if (!odgovor.ok) {
              throw new Error("Dohvat ostalih objava nije uspio.");
            }

            const rezultat = await odgovor.json();

            // Dodavanje novih kartica na kraj postojećih
            spremnikOstalihObjava.insertAdjacentHTML(
              "beforeend",
              rezultat.html
            );

            // Pamtimo gdje smo stali
            offset = rezultat.sljedeciOffset;

            // Provjeravamo postoje li još objave
            imaJosObjava = rezultat.imaJos;

            if (!imaJosObjava) {
              observer.disconnect();
              ucitavanjeOstalih.remove();
            }

          } catch (error) {
            console.error("Greška kod učitavanja ostalih objava:", error);
            observer.disconnect();
            ucitavanjeOstalih.textContent =
              "Došlo je do greške kod učitavanja objava.";
          } finally {
            ucitavanjeUTijeku = false;
          }
        }

        // Učitavanje kada se približimo dnu stranice
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              ucitajOstaleObjave();
            }
          });
        }, {
          root: null,
          rootMargin: "300px",
          threshold: 0
        });

        observer.observe(ucitavanjeOstalih);
      }




    </script>
</body>

</html>