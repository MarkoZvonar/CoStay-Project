@startuml

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

title UML dijagram klasa - Inbox

' =====================================================
' POSTOJEĆA IMPLEMENTACIJA
' =====================================================

package "Postojeca implementacija" {

    class InboxRouter <<JavaScript modul>> {
        +GET /inbox
        +GET /inbox/razgovori
        +GET /inbox/razgovori/:id/poruke
        +POST /inbox/razgovori/:id/poruke
    }

    class InboxView <<EJS predlozak>> {
        +popis razgovora
        +prikaz sudionika
        +prikaz poruka
        +unos i slanje poruke
    }

    class SupabaseClient <<vanjska biblioteka>>

    InboxView ..> InboxRouter : HTTP zahtjevi
    InboxRouter ..> SupabaseClient : pristup bazi
}

' =====================================================
' MODEL PODATAKA
' =====================================================

package "Model podataka - baza" {

    class RAZGOVOR <<tablica>> {
        +id_razgovor : UUID
        +razgovor_tip : {izravni, grupni}
        +id_objava : UUID
    }

    class SUGOVORNIK <<tablica>> {
        +id_razgovor : UUID
        +id_sugovornik : UUID
    }

    class PORUKA <<tablica>> {
        +id_poruka : UUID
        +id_razgovor : UUID
        +id_posiljatelj : UUID
        +poruka : TEXT
        +vrijeme_slanja : TIMESTAMP
    }

    RAZGOVOR "1" -- "0..*" SUGOVORNIK : sudionici
    RAZGOVOR "1" -- "0..*" PORUKA : sadrzi
}

' =====================================================
' PREDLOZENI MODEL OBLIKOVANJA
' =====================================================

package "Predlozeni model oblikovanja" {

    class ConversationService <<model oblikovanja>> {
        +getConversations(userId)
        +getConversation(id)
        +createDirectConversation(user1, user2)
        +createGroupConversation(postId, participants)
    }

    class MessageService <<model oblikovanja>> {
        +getMessages(conversationId)
        +sendMessage(conversationId, senderId, content)
    }

    class RealtimeService <<model oblikovanja>> {
        +subscribeToConversation(id)
        +unsubscribeFromConversation(id)
        +onNewMessage(callback)
    }

    interface ConversationRepository {
        +findByUser(userId)
        +findById(id)
        +create(conversation)
        +addParticipant(conversationId, userId)
    }

    interface MessageRepository {
        +findByConversation(conversationId)
        +save(message)
    }

    interface RealtimeGateway {
        +subscribe(channel)
        +unsubscribe(channel)
    }

    ConversationService --> ConversationRepository
    MessageService --> MessageRepository
    RealtimeService --> RealtimeGateway

    ConversationService ..> MessageService
}

' =====================================================
' POVEZIVANJE POSTOJECE I BUDUCE IMPLEMENTACIJE
' =====================================================

InboxRouter ..> ConversationService : buduca uporaba
InboxRouter ..> MessageService : buduca uporaba

note right of RAZGOVOR
    razgovor_tip odreduje vrstu razgovora:
    - izravni
    - grupni

    id_objava povezuje razgovor
    s pripadajucom objavom.
end note

note right of ConversationService
    Automatsko stvaranje grupnog razgovora
    predvideno je za buducu implementaciju.

    Grupni razgovor stvarat ce se nakon
    dogovora o putovanju, za autora objave
    i potvrdene sudionike.
end note

note bottom of RealtimeService
    Realtime komunikacija dio je
    predlozenog modela oblikovanja.

    Nije implementirana u trenutno
    prikazanom JavaScript kodu.
end note

@enduml
