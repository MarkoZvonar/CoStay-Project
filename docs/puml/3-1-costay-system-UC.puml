@startuml
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 48
skinparam defaultFontName Arial

skinparam usecase {
  BackgroundColor #F5F9FF
  BorderColor #31557A
  ArrowColor #526B83
}

skinparam actor {
  BorderColor #31557A
}

skinparam package {
  BorderColor #8097AA
  BackgroundColor #FFFFFF
}

skinparam rectangle {
  BorderColor #31557A
}

actor "Neregistrirani\nposjetitelj" as Guest
actor "Registrirani\nkorisnik" as User
actor "Autor objave /\nvlasnik" as Owner
actor "Administrator" as Admin

actor "OAuth pružatelj\nidentiteta" as OAuth
actor "Vanjski servis\nza karte" as Maps
actor "E-mail servis" as Email

' Generalizacija aktera
Owner --|> User

rectangle "CoStay" {

  package "Korisnički račun" {
    usecase "Registracija i dovršavanje\nkorisničkog profila" as UC_Register
    usecase "Prijava u sustav" as UC_Login
    usecase "Unos neobaveznog opisa\ni ključnih riječi" as UC_Keywords
    usecase "Odjava iz aplikacije" as UC_Logout
    usecase "Ponovno postavljanje lozinke" as UC_Recovery
    usecase "Upravljanje korisničkim profilom" as UC_Profile
  }

  package "Pregled i objave" {
    usecase "Pregled objava na Discoveru" as UC_Discover
    usecase "Pretraživanje objava na Searchu" as UC_Search
    usecase "Izrada objave putovanja" as UC_Create
    usecase "Uređivanje vlastite objave" as UC_Edit
    usecase "Spremanje objave" as UC_Save
    usecase "Pregled spremljenih objava" as UC_Saved
    usecase "Odabir lokacije" as UC_Location
  }

  package "Zahtjevi za pridruživanje" {
    usecase "Slanje zahtjeva za pridruživanje" as UC_Join
    usecase "Pregled vlastitih zahtjeva\nza pridruživanje" as UC_MyRequests
    usecase "Povlačenje zahtjeva\nili sudjelovanja" as UC_Withdraw
    usecase "Pregled pristiglih zahtjeva" as UC_Received
    usecase "Prihvaćanje ili odbijanje zahtjeva" as UC_Decide
    usecase "Pregled prijavljenih osoba" as UC_Applicants
    usecase "Odluka o putovanju s manjom grupom" as UC_SmallerGroup
  }

  package "Komunikacija i putovanja" {
    usecase "Izravni razgovor" as UC_Messages
    usecase "Grupni razgovor" as UC_GroupMessages
    usecase "Pregled troškova putovanja" as UC_Costs
    usecase "Simulacija plaćanja" as UC_Payment
    usecase "Ocjenjivanje sudionika" as UC_Reviews
  }

  package "Moderiranje" {
    usecase "Prijavljivanje sadržaja ili korisnika" as UC_Report
    usecase "Moderiranje sadržaja i računa" as UC_Moderate
    usecase "Pregled statistike i izvoz podataka" as UC_Statistics
  }

  package "Obavijesti" {
    usecase "Slanje automatskih e-mail obavijesti" as UC_Notifications
  }
}

' ==========================================
' VEZE AKTERA I OBRAZACA UPORABE
' ==========================================

' Neregistrirani posjetitelj
Guest -- UC_Register
Guest -- UC_Login
Guest -- UC_Recovery
Guest -- UC_Discover
Guest -- UC_Search

' Registrirani korisnik
User -- UC_Login
User -- UC_Keywords
User -- UC_Logout
User -- UC_Profile
User -- UC_Discover
User -- UC_Search

' Jedan korisnik izraduje pojedinu objavu
User "1" -- UC_Create

User -- UC_Save
User -- UC_Saved
User -- UC_Join
User -- UC_MyRequests
User -- UC_Withdraw

' Izravni razgovor - dva sudionika
User "2" -- UC_Messages

' Grupni razgovor - najmanje dva sudionika
User "2..*" -- UC_GroupMessages

User -- UC_Costs
User -- UC_Payment
User -- UC_Reviews
User -- UC_Report
User -- UC_Location

' Autor objave
Owner "1" -- UC_Edit
Owner -- UC_Received
Owner "1" -- UC_Decide
Owner -- UC_Applicants
Owner -- UC_SmallerGroup

' Administrator
Admin -- UC_Moderate
Admin -- UC_Statistics

' Vanjski servisi
OAuth -- UC_Register
OAuth -- UC_Login

Maps -- UC_Location

Email -- UC_Recovery
Email -- UC_Notifications

' ==========================================
' INCLUDE - OBAVEZNO UKLJUCIVANJE
' ==========================================

' Izrada objave zahtijeva odabir lokacije
UC_Create ..> UC_Location : <<include>>

' ==========================================
' EXTEND - UVJETNA ILI OPCIONALNA RADNJA
' ==========================================

' Neobavezni podaci tijekom registracije
UC_Keywords ..> UC_Register : <<extend>>

' Spremanje objave tijekom pregledavanja
UC_Save ..> UC_Discover : <<extend>>
UC_Save ..> UC_Search : <<extend>>

' Slanje zahtjeva tijekom pregledavanja
UC_Join ..> UC_Discover : <<extend>>
UC_Join ..> UC_Search : <<extend>>

' Povlacenje vlastitog zahtjeva
UC_Withdraw ..> UC_MyRequests : <<extend>>

' Odlucivanje o pristiglom zahtjevu
UC_Decide ..> UC_Received : <<extend>>

' Simulacija placanja pri pregledu troskova
UC_Payment ..> UC_Costs : <<extend>>

' ==========================================
' OGRANICENJA I POSLOVNA PRAVILA
' ==========================================

note right of UC_Join
  {Korisnik je prijavljen;
   objava je otvorena.}

  Novi zahtjev ima status "na čekanju".
end note

note right of UC_SmallerGroup
  {Rok je istekao; cilj nije ostvaren.}

  Za potvrdu manje grupe potreban je
  autor i barem jedan drugi
  potvrdeni sudionik.

  Rok za odluku: 24 sata.
end note

note right of UC_GroupMessages
  Pristup imaju samo autor i konacno
  potvrdeni sudionici dogovorenog
  putovanja.

  Automatsko stvaranje grupnog
  razgovora je planirano.
end note

note right of UC_Reviews
  {Najvise 1 recenzija po paru
   korisnika, putovanju i smjeru.}

  Ocjenjivanje je dostupno
  nakon povratka s putovanja.
end note

note right of UC_Payment
  Simulacija placanja.

  Nema stvarnog prijenosa novca.
end note

note right of UC_Notifications
  Automatske obavijesti o:
  - statusima zahtjeva
  - rokovima
  - troskovima

  Integracija e-mail servisa
  je planirana.
end note

@enduml
